# ApplyAI - Git Ignore File
# This file prevents sensitive data from being committed to GitHub

# Configuration files with real credentials (use templates instead)
data/user_config.yaml
data/user_profile.yaml
data/resumes_config.yaml
data/schedule_config.yaml
data/authorized_users.yaml
data/smtp_config.yaml

# Keep template files
!data/*.template.yaml

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
jobspro_env/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# PyInstaller
*.manifest
*.spec
build/
dist/

# Logs
*.log

# Local development
.env
.env.local

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Testing
.pytest_cache/
.coverage
htmlcov/

# Temporary files
*.tmp
*.temp
